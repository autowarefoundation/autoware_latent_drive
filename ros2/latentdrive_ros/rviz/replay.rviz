# Open-loop replay of latentdrive_node, followed from behind the car: the plan
# it computes (green, map frame) next to the plan the vehicle recorded (orange,
# base_link), on the lanelet map with the route's lanes highlighted (map_viz,
# with lanelet_map:=), and the node's camera + BEV image. The route points fed
# to the model are a layer of their own, off by default
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.6
  Tree Height: 300
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: lanelet map
    Namespaces:
      {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_viz/vector_map
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: route lanes
    Namespaces:
      {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_viz/route
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: ego
    Namespaces:
      {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_viz/ego
    Value: true
  - Alpha: 0.3
    Cell Size: 5
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: false
    Name: Grid (5 m, base_link)
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: base_link
    Value: false
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: latentdrive_node plan (map)
    Line Style: Billboards
    Line Width: 0.6
    Color: 0; 230; 120
    Alpha: 1
    Buffer Length: 1
    Offset:
      X: 0
      Y: 0
      Z: 0.4
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /latentdrive_node/plan_map
    Value: true
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: vehicle plan (recorded, base_link)
    Line Style: Billboards
    Line Width: 0.25
    Color: 255; 170; 0
    Alpha: 0.9
    Buffer Length: 1
    Offset:
      X: 0
      Y: 0
      Z: 0.45
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /tensorrt_e2e/debug/latentdrive/plan
    Value: true
  - Class: rviz_default_plugins/PoseArray
    Enabled: false
    Name: route points fed to the model
    Shape: Arrow (Flat)
    Color: 235; 104; 52
    Alpha: 1
    Arrow Length: 1.0
    Head Length: 0.6
    Head Radius: 0.6
    Shaft Length: 0.6
    Shaft Radius: 0.3
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /latentdrive_node/route_points
    Value: false
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: latentdrive_node viz (camera + BEV)
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /latentdrive_node/viz/compressed
    Value: true
  Enabled: true
  Global Options:
    Background Color: 12; 13; 16
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    # Behind and above the car, looking ahead along its heading: the camera
    # turns with base_link, so the plan always runs up the screen
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 30
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      # Not 0.01: the depth buffer then cannot tell the map's layers (5 cm
      # apart) from each other 50 m away
      Near Clip Distance: 0.5
      Pitch: 0.42
      Target Frame: base_link
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 3.14159
    Saved:
    - Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 12
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 15
      Y: 0
      Angle: 0
Window Geometry:
  Height: 1200
  Width: 2200
  X: 0
  Y: 0
  Displays:
    collapsed: false
  Views:
    collapsed: true
