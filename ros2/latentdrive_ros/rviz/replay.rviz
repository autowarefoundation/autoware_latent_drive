# Open-loop replay of latentdrive_node: the plan it computes (green, map frame)
# next to the plan the vehicle recorded (orange, base_link), the route points
# fed to the model, the ego TF, and the node's camera + BEV image
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.6
  Tree Height: 300
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 5
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Name: Grid (5 m, base_link)
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: base_link
    Value: true
  - Class: rviz_default_plugins/Axes
    Enabled: true
    Length: 2
    Name: base_link
    Radius: 0.15
    Reference Frame: base_link
    Value: true
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: latentdrive_node plan (map)
    Line Style: Billboards
    Line Width: 0.35
    Color: 0; 220; 120
    Alpha: 0.9
    Buffer Length: 1
    Offset:
      X: 0
      Y: 0
      Z: 0.1
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /latentdrive_node/plan_map
    Value: true
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: vehicle plan (recorded, base_link)
    Line Style: Billboards
    Line Width: 0.2
    Color: 255; 170; 0
    Alpha: 0.9
    Buffer Length: 1
    Offset:
      X: 0
      Y: 0
      Z: 0.05
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /tensorrt_e2e/debug/latentdrive/plan
    Value: true
  - Class: rviz_default_plugins/PoseArray
    Enabled: true
    Name: route points fed to the model
    Shape: Arrow (Flat)
    Color: 235; 104; 52
    Alpha: 1
    Arrow Length: 1.0
    Head Length: 0.6
    Head Radius: 0.6
    Shaft Length: 0.6
    Shaft Radius: 0.3
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /latentdrive_node/route_points
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: latentdrive_node viz (camera + BEV)
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /latentdrive_node/viz/compressed
    Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 12
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 15
      Y: 0
      Angle: 0
    Saved: []
Window Geometry:
  Height: 1200
  Width: 2200
  X: 0
  Y: 0
  Displays:
    collapsed: false
  Views:
    collapsed: true
