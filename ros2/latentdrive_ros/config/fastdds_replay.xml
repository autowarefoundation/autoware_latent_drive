<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast-DDS profile for replaying ~1 MB camera frames on one host: a shared-memory segment
     large enough that big messages stay on SHM instead of falling back to fragmented UDP,
     whose socket buffer (net.core.rmem_max, 208 KB here) cannot be raised without root. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
      <maxMessageSize>134217728</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_default</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="big_shm_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp_default</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
